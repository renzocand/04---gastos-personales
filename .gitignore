# === Monorepo root ===
# Cada subproyecto (frontend/) tiene además su propio .gitignore.

# Backend (Spring Boot / Maven)
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class

# Logs
*.log

# IDEs y editores
.idea/
*.iml
.project
.classpath
.settings/

# Variables de entorno (secretos). Se versiona solo .env.example.
.env

# JMeter (pruebas no funcionales): se versiona solo el plan (.jmx), el script y el
# README; los resultados crudos (.jtl) y los dashboards HTML (rep-*) son generados.
perf/*.jtl
perf/rep-*/
# jmeter.log ya queda cubierto por la regla *.log de arriba.

# Sistema
.DS_Store
Thumbs.db
