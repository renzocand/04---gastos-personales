# Plantilla de variables de entorno. Copiá este archivo a `.env` y completá los
# valores. docker-compose lee `.env` automáticamente al hacer `docker compose up`.

# Secreto para firmar los JWT (HS256). DEBE tener al menos 32 caracteres.
# Generá uno fuerte, por ejemplo:  openssl rand -base64 48
APP_JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Token del bot de Telegram. Obtenelo de @BotFather en Telegram.
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot y sigue las instrucciones
# 3. Copia el token que te da
TELEGRAM_BOT_TOKEN=tu-token-de-botfather
