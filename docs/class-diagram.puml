@startuml class-diagram
title Diagrama de Clases - Backend Gastos Personales

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ===== Capa model (dominio / entidades JPA) =====
package "model" {
    enum Currency {
        PEN
        USD
    }

    class Category {
        - id : String
        - name : String
        - icon : String
        - description : String
        - sortOrder : Integer
    }

    class Expense {
        - id : String
        - amount : BigDecimal
        - currency : Currency
        - description : String
        - date : LocalDate
        - createdAt : Instant
        - updatedAt : Instant
        + assignId() : void
    }

    class User {
        - id : String
        - dni : String
        - password : String
        - firstName : String
        - lastName : String
        - secondLastName : String
        - email : String
        - role : String
        - createdAt : Instant
        + assignId() : void
    }

    class UserSettings {
        - id : String
        - monthlyIncome : BigDecimal
        - alertsEnabled : boolean
        - updatedAt : Instant
    }
}

' ===== Capa dto (contratos de la API) =====
package "dto" {
    class ExpenseRequest <<record>> {
        + amount : BigDecimal
        + currency : Currency
        + description : String
        + categoryId : String
        + date : LocalDate
    }
    class ExpenseUpdateRequest <<record>> {
        + amount : BigDecimal
        + currency : Currency
        + description : String
        + categoryId : String
        + date : LocalDate
    }
    class ExpenseResponse <<record>> {
        + id : String
        + currency : Currency
        + amount : BigDecimal
        + description : String
        + categoryId : String
        + date : LocalDate
        + createdAt : Instant
        + updatedAt : Instant
    }
    class CategoryResponse <<record>> {
        + id : String
        + name : String
        + icon : String
        + description : String
    }
    class ExchangeRateResponse <<record>> {
        + rate : BigDecimal
    }
    class RegisterRequest <<record>> {
        + dni : String
        + password : String
        + firstName : String
        + lastName : String
        + secondLastName : String
        + email : String
    }
    class LoginRequest <<record>> {
        + dni : String
        + password : String
    }
    class AuthResponse <<record>> {
        + token : String
        + tokenType : String
        + dni : String
        + firstName : String
        + lastName : String
    }
    class UserResponse <<record>> {
        + dni : String
        + firstName : String
        + lastName : String
        + secondLastName : String
        + email : String
        + role : String
    }
    class SettingsResponse <<record>> {
        + monthlyIncome : BigDecimal
        + alertsEnabled : boolean
    }
    class SettingsUpdateRequest <<record>> {
        + monthlyIncome : BigDecimal
        + alertsEnabled : boolean
    }
}

' ===== Capa mapper =====
package "mapper" {
    class ExpenseMapper {
        + toResponse(e : Expense) : ExpenseResponse
        + toEntity(req : ExpenseRequest, category : Category, user : User) : Expense
        + toResponse(c : Category) : CategoryResponse
    }
}

' ===== Capa repository =====
package "repository" {
    interface ExpenseRepository {
        + findFiltered(dni, categoryId, currency, dateFrom, dateTo) : List<Expense>
        + findByIdAndUser_Dni(id, dni) : Optional<Expense>
    }
    interface CategoryRepository
    interface UserRepository {
        + findByDni(dni) : Optional<User>
        + existsByDni(dni) : boolean
    }
    interface UserSettingsRepository {
        + findByUser_Dni(dni) : Optional<UserSettings>
    }
}

' ===== Capa service =====
package "service" {
    class ExpenseService {
        + findAll(dni, categoryId, currency, dateFrom, dateTo) : List<ExpenseResponse>
        + create(dni : String, req : ExpenseRequest) : ExpenseResponse
        + update(dni : String, id : String, req : ExpenseUpdateRequest) : ExpenseResponse
        + delete(dni : String, id : String) : void
    }
    class CategoryService {
        + findAll() : List<CategoryResponse>
    }
    class AuthService {
        + register(req : RegisterRequest) : AuthResponse
        + login(req : LoginRequest) : AuthResponse
        + me(dni : String) : UserResponse
    }
    class SettingsService {
        + get(dni : String) : SettingsResponse
        + update(dni : String, req : SettingsUpdateRequest) : SettingsResponse
    }
    class ExchangeRateService {
        + getUsdToPen() : BigDecimal
    }
}

' ===== Capa controller =====
package "controller" {
    class ExpenseController {
        + list(auth, ...) : List<ExpenseResponse>
        + create(auth, req : ExpenseRequest) : ExpenseResponse
        + update(auth, id, req : ExpenseUpdateRequest) : ExpenseResponse
        + delete(auth, id : String) : void
    }
    class CategoryController {
        + list() : List<CategoryResponse>
    }
    class AuthController {
        + register(req : RegisterRequest) : AuthResponse
        + login(req : LoginRequest) : AuthResponse
        + me(auth) : UserResponse
    }
    class SettingsController {
        + get(auth) : SettingsResponse
        + update(auth, req : SettingsUpdateRequest) : SettingsResponse
    }
    class ExchangeRateController {
        + get() : ExchangeRateResponse
    }
}

' ===== Capa security (autenticación JWT) =====
package "security" {
    class JwtService {
        + generateToken(dni : String) : String
        + extractDni(token : String) : String
        + isTokenValid(token : String, dni : String) : boolean
    }
    class JwtAuthenticationFilter {
        # doFilterInternal(req, res, chain) : void
    }
    class CustomUserDetailsService {
        + loadUserByUsername(dni : String) : UserDetails
    }
    class JsonAuthenticationEntryPoint {
        + commence(req, res, ex) : void
    }
}

' ===== Capa config =====
package "config" {
    class SecurityConfig {
        + securityFilterChain(http) : SecurityFilterChain
        + authenticationProvider() : DaoAuthenticationProvider
        + passwordEncoder() : PasswordEncoder
        + corsConfigurationSource() : CorsConfigurationSource
    }
    class I18nConfig {
        + messageSource() : MessageSource
        + localeResolver() : LocaleResolver
        + getValidator() : Validator
    }
}

' ===== Capa i18n (internacionalización) =====
package "i18n" {
    class Messages {
        + get(code : String, args : Object...) : String
    }
}

' ===== Capa exception =====
package "exception" {
    class NotFoundException
    class ConflictException
    class GlobalExceptionHandler
}

' ===== Relaciones de dominio =====
Expense "*" --> "1" Category : category
Expense "*" --> "1" User : user
Expense ..> Currency
User "1" --> "0..1" UserSettings : settings

' ===== Relaciones entre capas =====
ExpenseController --> ExpenseService
CategoryController --> CategoryService
AuthController --> AuthService
SettingsController --> SettingsService
ExchangeRateController --> ExchangeRateService
ExpenseService --> ExpenseRepository
ExpenseService --> CategoryRepository
ExpenseService --> UserRepository
ExpenseService --> ExpenseMapper
CategoryService --> CategoryRepository
CategoryService --> ExpenseMapper
AuthService --> UserRepository
AuthService --> JwtService
SettingsService --> UserSettingsRepository
SettingsService --> UserRepository
ExpenseRepository ..> Expense
CategoryRepository ..> Category
UserRepository ..> User
UserSettingsRepository ..> UserSettings

' ===== Relaciones de seguridad =====
JwtAuthenticationFilter --> JwtService
JwtAuthenticationFilter --> CustomUserDetailsService
CustomUserDetailsService --> UserRepository
SecurityConfig --> JwtAuthenticationFilter
SecurityConfig --> JsonAuthenticationEntryPoint

' ===== Excepciones =====
ExpenseService ..> NotFoundException
AuthService ..> ConflictException
AuthService ..> NotFoundException
SettingsService ..> NotFoundException
GlobalExceptionHandler ..> NotFoundException
GlobalExceptionHandler ..> ConflictException

' ===== Internacionalización (i18n) =====
' El idioma se resuelve por Accept-Language (es / en / qu). Messages traduce los
' textos de error; los DTOs llevan claves {clave} validadas contra el MessageSource.
I18nConfig ..> Messages : provee MessageSource
ExpenseService --> Messages
AuthService --> Messages
SettingsService --> Messages
CustomUserDetailsService --> Messages
GlobalExceptionHandler --> Messages
JsonAuthenticationEntryPoint ..> I18nConfig : MessageSource\n(request.getLocale())

@enduml
