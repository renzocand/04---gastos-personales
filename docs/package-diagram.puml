@startuml package-diagram
title Diagrama de Paquetes - Backend Gastos Personales (com.gastos)

skinparam packageStyle rectangle
left to right direction

package "com.gastos" {
    package "controller" as controller
    package "service" as service
    package "repository" as repository
    package "model" as model
    package "dto" as dto
    package "mapper" as mapper
    package "exception" as exception
    package "security" as security
    package "config" as config
}

database "MySQL" as db

' Dependencias entre capas (flujo de la petición: arriba -> abajo)
controller ..> service
controller ..> dto
service ..> repository
service ..> mapper
service ..> dto
service ..> exception
repository ..> model
mapper ..> model
mapper ..> dto
controller ..> exception : @RestControllerAdvice

' Seguridad: filtro JWT delante de los controllers, valida el token por petición
security ..> service
security ..> repository
security ..> model
config ..> security : SecurityFilterChain + CORS
config ..> repository : DemoDataSeeder

' Infraestructura
repository ..> db : JPA / Hibernate

@enduml
