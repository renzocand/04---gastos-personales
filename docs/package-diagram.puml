@startuml package-diagram
title Diagrama de Paquetes - Backend Gastos Personales (com.gastos)

skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction


package "com.gastos" {
    package "controller" as controller
    package "service" as service
    package "repository" as repository
    package "model" as model
    package "dto" as dto
    package "mapper" as mapper
    package "security" as security
    package "exception" as exception
    package "config" as config
    package "i18n" as i18n
}

' Dependencias entre paquetes (la arquitectura por capas)
controller ..> service
service ..> repository
service ..> mapper
service ..> exception
mapper ..> dto
mapper ..> model
repository ..> model
security ..> service
exception ..> i18n
config ..> security

@enduml
